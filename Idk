local discoButton = makeButton("Disco OFF", 245)

-- FLY
local flying = false
local noclipFlying = false
local speed = 70

local bodyVelocity
local bodyGyro

local controls = {W=false,A=false,S=false,D=false}

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.W then controls.W = true end
	if input.KeyCode == Enum.KeyCode.A then controls.A = true end
	if input.KeyCode == Enum.KeyCode.S then controls.S = true end
	if input.KeyCode == Enum.KeyCode.D then controls.D = true end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.W then controls.W = false end
	if input.KeyCode == Enum.KeyCode.A then controls.A = false end
	if input.KeyCode == Enum.KeyCode.S then controls.S = false end
	if input.KeyCode == Enum.KeyCode.D then controls.D = false end
end)

local function stopFly()
	flying = false
	noclipFlying = false

	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end

	for _,v in pairs(character:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = true
		end
	end
end

local function startFly(noclip)
	stopFly()

	flying = true
	noclipFlying = noclip

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
	bodyVelocity.Parent = humanoidRootPart

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
	bodyGyro.Parent = humanoidRootPart

	task.spawn(function()
		while flying do
			RunService.RenderStepped:Wait()

			local dir = Vector3.zero
			if controls.W then dir += camera.CFrame.LookVector end
			if controls.S then dir -= camera.CFrame.LookVector end
			if controls.A then dir -= camera.CFrame.RightVector end
			if controls.D then dir += camera.CFrame.RightVector end

			bodyVelocity.Velocity =
				(dir.Magnitude > 0 and dir.Unit * speed) or Vector3.zero

			bodyGyro.CFrame = camera.CFrame

			if noclipFlying then
				for _,v in pairs(character:GetDescendants()) do
					if v:IsA("BasePart") then
						v.CanCollide = false
					end
				end
			end
		end
	end)
end

flyButton.MouseButton1Click:Connect(function()
	if flying and not noclipFlying then
		stopFly()
		flyButton.Text = "Fly"
	else
		startFly(false)
		flyButton.Text = "Stop Fly"
	end
end)

noclipFlyButton.MouseButton1Click:Connect(function()
	if flying and noclipFlying then
		stopFly()
		noclipFlyButton.Text = "Noclip Fly"
	else
		startFly(true)
		noclipFlyButton.Text = "Stop Noclip"
	end
end)

-- TELEPORT
teleportButton.MouseButton1Click:Connect(function()
	local list = {}
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(list, p)
		end
	end

	if #list > 0 then
		local t = list[math.random(1,#list)]
		if t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
			humanoidRootPart.CFrame =
				t.Character.HumanoidRootPart.CFrame + Vector3.new(0,5,0)
		end
	end
end)

-- ORBIT (your working version kept)
local orbitParts = {}

orbitButton.MouseButton1Click:Connect(function()
	for _,obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Parent ~= character then
			if (obj.Position - humanoidRootPart.Position).Magnitude <= 50 then
				obj.Anchored = false
				obj.CanCollide = false
				table.insert(orbitParts, obj)
			end
		end
	end
end)

task.spawn(function()
	while true do
		RunService.RenderStepped:Wait()

		for i, part in ipairs(orbitParts) do
			if part and humanoidRootPart then
				local angle = tick()*2 + i*0.4
				local radius = 55

				part.Position = humanoidRootPart.Position + Vector3.new(
					math.cos(angle)*radius,
					(i%10)*4,
					math.sin(angle)*radius
				)
			end
		end
	end
end)

-- 🎉 DISCO MODE (REPLACED KNOCKBACK)
local discoEnabled = false

local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://1846368080"
sound.Looped = true
sound.Volume = 1
sound.Parent = workspace

local function startDisco()
	sound:Play()

	task.spawn(function()
		while discoEnabled do
			Lighting.Ambient = Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255))
			Lighting.OutdoorAmbient = Lighting.Ambient
			Lighting.FogColor = Lighting.Ambient
			task.wait(0.2)
		end
	end)
end

local function stopDisco()
	sound:Stop()
	Lighting.Ambient = Color3.fromRGB(128,128,128)
	Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
	Lighting.FogColor = Color3.fromRGB(192,192,192)
end

discoButton.MouseButton1Click:Connect(function()
	discoEnabled = not discoEnabled

	if discoEnabled then
		discoButton.Text = "Disco ON"
		startDisco()
	else
		discoButton.Text = "Disco OFF"
		stopDisco()
	end
end)
